# Copy to `.env.local` (gitignored) and fill in your Supabase project values.
#
# When BOTH are set, the app runs in production mode: Google sign-in is required
# and rosters are read/written from Supabase. When absent, the app runs in the
# login-free local YAML playground.
#
# Local Supabase (`supabase start`) prints these on startup:
#   VITE_SUPABASE_URL=http://localhost:54321
#   VITE_SUPABASE_ANON_KEY=<anon key printed by `supabase start`>
#
# Hosted project: Dashboard → Project Settings → API.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
